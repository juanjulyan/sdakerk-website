# Required for church submissions and approved church listings.
# Copy as .env.local for local development, or add in Vercel Project Settings > Environment Variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required for sending the contact form to hi@sdakerk.com (verify sdakerk.com with Resend first).
RESEND_API_KEY=
CONTACT_FROM_EMAIL=SDA Kerk <no-reply@sdakerk.com>

# Required for newest YouTube uploads via YouTube Data API v3.
YOUTUBE_API_KEY=

# Optional: access to licensed Bible translations through API.Bible.
# Only configure translation IDs after obtaining the necessary publisher permissions.
BIBLE_API_KEY=
BIBLE_ID_AF1953=
BIBLE_ID_AF1983=
BIBLE_ID_AF2020=
BIBLE_ID_BOODSKAP=
BIBLE_ID_CEB=
BIBLE_ID_MESSAGE=
BIBLE_ID_HEBREW=
BIBLE_ID_GREEK=
