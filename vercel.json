{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), camera=(), microphone=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/oor-ons",
      "destination": "/about"
    },
    {
      "source": "/bybel",
      "destination": "/bible"
    },
    {
      "source": "/studie",
      "destination": "/study"
    },
    {
      "source": "/boeke",
      "destination": "/books"
    },
    {
      "source": "/videos",
      "destination": "/videos"
    },
    {
      "source": "/gemeentes",
      "destination": "/churches"
    },
    {
      "source": "/kontak",
      "destination": "/contact"
    },
    {
      "source": "/privaatheid",
      "destination": "/privacy"
    },
    {
      "source": "/bepalings",
      "destination": "/terms"
    }
  ]
}
